{
  "name": "goemoji",
  "version": "0.1.1",
  "description": "Лёгкий эмодзи-пикер для React: вкладки категорий, поиск, скины и серверные эмодзи Discord.",
  "license": "MIT",
  "author": "VolRencs",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.5.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VolRencs/goemoji.git"
  },
  "homepage": "https://github.com/VolRencs/goemoji",
  "bugs": {
    "url": "https://github.com/VolRencs/goemoji/issues"
  },
  "keywords": [
    "emoji",
    "emoji-picker",
    "react",
    "discord",
    "discord-emoji",
    "server-emojis"
  ],
  "files": [
    "dist",
    "data",
    "README.md",
    "README.ru.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./discord": {
      "types": "./dist/discord.d.ts",
      "import": "./dist/discord.js"
    },
    "./styles.css": "./dist/styles.css",
    "./data/ru.json": "./data/ru.json",
    "./data/en.json": "./data/en.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "data": "node scripts/build-data.ts",
    "size": "node scripts/size-budget.ts",
    "smoke": "node scripts/smoke.ts",
    "dev": "vite --config demo/vite.config.ts",
    "prepare": "tsup",
    "prepublishOnly": "pnpm check && pnpm test && pnpm build && pnpm size && pnpm smoke"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "emojibase-data": "^17.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
