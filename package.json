{
  "name": "goemoji",
  "version": "0.3.1",
  "description": "Лёгкий эмодзи-пикер для React: вкладки категорий, поиск, скины и серверные эмодзи Discord.",
  "license": "MIT",
  "author": "VolRencs",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VolRencs/goemoji.git"
  },
  "homepage": "https://github.com/VolRencs/goemoji",
  "bugs": {
    "url": "https://github.com/VolRencs/goemoji/issues"
  },
  "keywords": [
    "emoji",
    "emoji-picker",
    "react",
    "discord",
    "discord-emoji",
    "server-emojis"
  ],
  "files": [
    "dist",
    "data",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./discord": {
      "types": "./dist/discord.d.ts",
      "import": "./dist/discord.js",
      "default": "./dist/discord.js"
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    },
    "./data/ru.json": "./data/ru.json",
    "./data/en.json": "./data/en.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "data": "node scripts/build-data.ts",
    "size": "node scripts/size-budget.ts",
    "smoke": "node scripts/smoke.mjs",
    "lint:package": "LINT_PACKAGE=1 tsdown",
    "dev": "vite --config demo/vite.config.ts",
    "prepare": "tsdown",
    "prepublishOnly": "pnpm check && pnpm test && pnpm lint:package && pnpm size && pnpm smoke"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@tsdown/css": "^0.23.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "emojibase": "^18.0.0",
    "emojibase-data": "^18.0.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
